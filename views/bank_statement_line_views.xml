<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         BANK LINES: statement lines with Unit / Contract / Purpose
         ============================================================ -->
    <record id="rental_bank_line_list_view" model="ir.ui.view">
        <field name="name">account.bank.statement.line.rental.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0"
                  decoration-muted="is_reconciled"
                  decoration-success="not is_reconciled and amount &gt; 0"
                  decoration-danger="not is_reconciled and amount &lt; 0">
                <field name="date" readonly="1"/>
                <field name="journal_id" readonly="1" optional="show"/>
                <field name="payment_ref" readonly="1"/>
                <field name="ref" readonly="1" optional="show"/>
                <field name="partner_id" readonly="is_reconciled"/>
                <field name="bank_tenancy_id" options="{'no_create': True}"/>
                <field name="bank_property_id" options="{'no_create': True}"/>
                <field name="bank_project_id" optional="hide"/>
                <field name="bank_purpose"/>
                <field name="bank_category"/>
                <field name="amount_in" sum="Money In"/>
                <field name="amount_out" sum="Money Out"/>
                <field name="amount" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_reconciled" widget="boolean" string="Reconciled" readonly="1"/>
                <button name="action_open_reconcile" type="object" string="Reconcile"
                        icon="fa-check-square-o" class="btn-link"
                        invisible="is_reconciled"/>
            </list>
        </field>
    </record>

    <record id="rental_bank_line_search_view" model="ir.ui.view">
        <field name="name">account.bank.statement.line.rental.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_ref" string="Label"/>
                <field name="ref"/>
                <field name="partner_id"/>
                <field name="bank_tenancy_id"/>
                <field name="bank_property_id"/>
                <field name="bank_project_id"/>
                <field name="bank_purpose"/>
                <field name="journal_id"/>
                <filter name="not_reconciled" string="To Reconcile" domain="[('is_reconciled', '=', False)]"/>
                <filter name="reconciled" string="Reconciled" domain="[('is_reconciled', '=', True)]"/>
                <separator/>
                <filter name="money_in" string="Money In" domain="[('amount', '&gt;', 0)]"/>
                <filter name="money_out" string="Money Out" domain="[('amount', '&lt;', 0)]"/>
                <separator/>
                <filter name="no_unit" string="Missing Unit" domain="[('bank_property_id', '=', False)]"/>
                <filter name="no_category" string="Missing Category" domain="[('bank_category', '=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_by_unit" string="Unit" context="{'group_by': 'bank_property_id'}"/>
                    <filter name="group_by_contract" string="Contract" context="{'group_by': 'bank_tenancy_id'}"/>
                    <filter name="group_by_building" string="Building" context="{'group_by': 'bank_project_id'}"/>
                    <filter name="group_by_category" string="Category" context="{'group_by': 'bank_category'}"/>
                    <filter name="group_by_partner" string="Partner" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_journal" string="Bank" context="{'group_by': 'journal_id'}"/>
                    <filter name="group_by_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="rental_bank_line_pivot_view" model="ir.ui.view">
        <field name="name">account.bank.statement.line.rental.pivot</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <pivot string="Bank by Unit">
                <field name="bank_property_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount_in" type="measure"/>
                <field name="amount_out" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_rental_bank_lines" model="ir.actions.act_window">
        <field name="name">Bank Lines</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="context">{'search_default_not_reconciled': 1}</field>
        <field name="search_view_id" ref="rental_bank_line_search_view"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('rental_bank_line_list_view')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('rental_bank_line_pivot_view')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bank lines yet</p>
            <p>Use <b>Import Bank Statement</b> to upload your bank's Excel with Unit,
               Contract, Purpose and Category columns.</p>
        </field>
    </record>

    <record id="action_rental_bank_by_unit" model="ir.actions.act_window">
        <field name="name">Bank by Unit</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[('journal_id.type', '=', 'bank')]</field>
        <field name="search_view_id" ref="rental_bank_line_search_view"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('rental_bank_line_pivot_view')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('rental_bank_line_list_view')})]"/>
    </record>

    <!-- "Detect Unit / Contract" on selected lines -->
    <record id="action_server_detect_rental" model="ir.actions.server">
        <field name="name">Detect Unit / Contract</field>
        <field name="model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_model_id" ref="account.model_account_bank_statement_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_detect_rental()</field>
    </record>

    <!-- ============================================================
         IMPORT WIZARD
         ============================================================ -->
    <record id="rental_bank_import_wizard_form" model="ir.ui.view">
        <field name="name">rental.bank.import.wizard.form</field>
        <field name="model">rental.bank.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Bank Statement">
                <div class="alert alert-info" role="alert">
                    <ol class="mb-0">
                        <li>Choose the bank.</li>
                        <li><b>Download Template</b>, paste your bank lines into it and fill
                            <b>Contract / Unit / Purpose / Category</b> where you can
                            (delete the example rows).</li>
                        <li>Select the filled file below and click <b>Import</b>.</li>
                    </ol>
                </div>
                <group>
                    <field name="journal_id" options="{'no_create': True}"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="skip_duplicates"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import"
                            class="btn-primary" icon="fa-upload" invisible="not file"/>
                    <button name="action_download_template" type="object"
                            string="Download Template" class="btn-secondary" icon="fa-download"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_rental_bank_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Bank Statement</field>
        <field name="res_model">rental.bank.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ============================================================
         SMART BUTTONS on contract and unit
         ============================================================ -->
    <record id="tenancy_details_form_view_inherit_bank" model="ir.ui.view">
        <field name="name">tenancy.details.form.inherit.bank</field>
        <field name="model">tenancy.details</field>
        <field name="inherit_id" ref="rental_management.tenancy_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bank_lines" type="object"
                        class="oe_stat_button" icon="fa-university"
                        invisible="not bank_line_count"
                        groups="account.group_account_invoice">
                    <field name="bank_line_count" string="Bank" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="property_details_form_view_inherit_bank" model="ir.ui.view">
        <field name="name">property.details.form.inherit.bank</field>
        <field name="model">property.details</field>
        <field name="inherit_id" ref="rental_management.property_details_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_bank_lines" type="object"
                        class="oe_stat_button" icon="fa-university"
                        invisible="not bank_line_count"
                        groups="account.group_account_invoice">
                    <field name="bank_line_count" string="Bank" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
